# Copy to .env for local/production runs. Never commit .env and never bake it into images.
GAMEMASTER_API_KEYS=
# Local development without a GPU: Ollama or any OpenAI-compatible server
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:1.7b
LLM_GUIDED_STYLE=none
LLM_ENABLED=false
GAMEMASTER_VRAM_GIB=12
# Merged fine-tuned policy directory inside the repo, e.g. checkpoints/connect4-merged
GAMEMASTER_POLICY_DIR=
